# NEVER commit real secrets. Use this file as a template only.

#############################
# 0G Chain Configuration
#############################
# 0G RPC endpoint (HTTP/WS). Example: https://rpc.0g.ai
0G_RPC_ENDPOINT="https://0g-mainnet-rpc.example"
# Numeric chain id for 0G network
0G_CHAIN_ID=16600
# Deployer or operator private key (use secrets manager in production)
DEPLOYER_PRIVATE_KEY="0x..."
LENDING_POOL_ADDRESS="0x..."
ARBITRAGE_EXECUTOR_ADDRESS="0x..."
SIGNAL_VALIDATOR_ADDRESS="0x..."

#############################
# 0G Compute (TEE) Configuration
#############################
# Toggle the environment: "local" for local TEE sandbox, "0g-compute" for provider
TEE_MODE="local"
# Base URL for 0G Compute sealed inference endpoint (testnet)
TEE_ENDPOINT="https://compute-testnet.0g.ai/v1/tee/infer"
TEE_API_KEY="your-tee-api-key"
TEE_REQUEST_TIMEOUT_MS=5000
TEE_SIGNATURE_VALIDATION=true
TEE_ATTESTATION_CERT_PATH="./certs/tee-attestation.pem"
# Local model path and expected sha256 hash (used in local TEE mode)
TEE_LOCAL_MODEL_PATH="./compute/models/arbitrage_scorer_v1.pkl"
TEE_LOCAL_MODEL_HASH="replace-with-sha256-hash"

#############################
# Private Mempool Configuration
#############################
MEMPOOL_PROVIDER="bloxroute"
MEMPOOL_API_KEY="your-mempool-key"
MEMPOOL_WEBSOCKET_URL="wss://mempool.example/ws"
MEMPOOL_SUBSCRIPTION_TOPICS='["pending-txs","liquidity-snapshots"]'
MEMPOOL_BUFFER_SIZE_MB=500

#############################
# Google Gemini AI Configuration
#############################
GEMINI_API_KEY="your-gemini-key"
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_MAX_TOKENS=2000
GEMINI_TEMPERATURE=0.3

#############################
# Arbitrage Parameters
#############################
MIN_PROFIT_MARGIN_PERCENT=3.0
MAX_COLLATERAL_RATIO=2.0
MAX_CONCURRENT_POSITIONS=3
DAILY_LOSS_CAP_USDT=-50
EXECUTION_TIMEOUT_SECONDS=30
GAS_PRICE_SPIKE_THRESHOLD_PERCENT=30

#############################
# Logging & Monitoring
#############################
LOG_LEVEL="INFO"
LOG_FILE_PATH="./logs/flashix.log"
METRICS_ENABLED=true
METRICS_PORT=9090
DATABASE_URL="sqlite:///./data/flashix.db"

#############################
# Optional Services
#############################
SENTRY_DSN=""
PROMETHEUS_ENDPOINT=""
S3_BUCKET_NAME=""

# Notes:
# - Fill values appropriately for local development in .env.local
# - Use secrets manager or CI/CD secrets for production values
# - Valid ranges: MIN_PROFIT_MARGIN_PERCENT (0.5 - 20), MAX_COLLATERAL_RATIO (1.0 - 5.0)
