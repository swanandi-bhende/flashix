# Deployer private key (64 hex chars, with or without 0x prefix)
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# 0G Chain Block Explorer API Key (for verification)
BLOCK_EXPLORER_API_KEY=

# Deployed contract addresses (populated after deployment)
LENDING_POOL_ADDRESS=
ARBITRAGE_EXECUTOR_ADDRESS=
SIGNAL_VALIDATOR_ADDRESS=

# Fee configuration
FLASHLOAN_FEE_BPS=9

# TEE signer address (0G Compute public key address for verifying signals)
TEE_SIGNER_ADDRESS=
